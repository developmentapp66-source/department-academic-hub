# Supabase Configuration (Required for Real Authentication)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# Important: Vite client-side environment variables MUST be prefixed with VITE_
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# AI Studio Deployment Variables
APP_URL="MY_APP_URL"
